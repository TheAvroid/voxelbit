#!/bin/sh
# voxelbit pre-commit -- the palette plate is a BUILD ARTIFACT.
#
# WHAT USED TO BE HERE, AND WHY IT IS NOT (2026-09-21). This hook's first job
# was rebuilding game/index.html from src/ and linting it: the browser engine
# was the game, index.html was its bundle, and a commit carrying a bundle that
# disagreed with its fragments was a black screen nobody could debug. That
# engine has been retired -- see the README -- so bundle.py, lint-vb.py and the
# browser palette plate went with it, and the three blocks that drove them are
# gone rather than left to fail on a missing file.
#
# Skip in an emergency with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

# ── game/assets/palette_v2.vox IS A BUILD ARTIFACT ──────────────────────────────────────────────────
# The engine holds a 255-entry table built at boot by Palette::forModelColor as each asset loads, and an
# id there is a MATERIAL -- roughness, translucency, alpha and the foliage classification all hang off the
# entry, so a colour that merely lands near an existing one is handed that entry's surface. The plate is
# the authoring reference for that table: open it beside new art and pick FROM it. A stale plate is worse
# than no plate, because it quietly recommends colours the table no longer holds.
#
# There is no static list to read -- the table IS the load order -- so `v1.exe --palette-vox` boots the
# engine and writes the live table out. That costs a GPU and ~15 s, which is why this is:
#   * conditional -- art under game/assets can mint an id, and so can any engine source, because WHICH
#     models load and IN WHAT ORDER is what the table is (first come; the last loader goes without).
#   * non-blocking -- no build, test or runtime path reads the plate. A machine with no GPU must still
#     be able to commit.
#   * YIELDING TO A PERSON. If any v1.exe is already up -- the user playing, or another Claude tab
#     mid-render -- this skips rather than adding a second engine to their GPU. See engine/CLAUDE.md, where
#     killing somebody else's engine is the one unrecoverable rudeness.
# Skip it for one commit with VB_SKIP_PALETTE=1.
EXE=engine/build/bin/Release/v1.exe
if [ -z "$VB_SKIP_PALETTE" ] &&
   git diff --cached --name-only | grep -Eq '^engine/src/|^game/assets/.*\.vox$'; then
  if [ ! -x "$EXE" ]; then
    echo "pre-commit: no $EXE - game/assets/palette_v2.vox may be stale (not fatal)" >&2
  elif tasklist //FI "IMAGENAME eq v1.exe" 2>/dev/null | grep -qi '^v1\.exe'; then
    # NOTE THE // -- Git Bash rewrites a single-slash /FI into a path. See
    # engine/CLAUDE.md, where the same line in build.bat misfires for the same reason.
    echo "pre-commit: v1.exe is already running - left palette_v2.vox alone (not fatal)" >&2
    echo "            re-run it yourself later: v1.exe --background --palette-vox" >&2
  else
    # A PLATE IS ONLY AS FRESH AS THE BINARY THAT PRINTED IT. If a staged source is newer than the exe,
    # the run would boot the OLD table and write it out as though it were the new one -- which is the
    # worst of the three outcomes, because it looks like it worked. Build first, or leave it stale and
    # say so.
    stale=
    for f in $(git diff --cached --name-only | grep -E '^engine/src/'); do
      [ -e "$f" ] && [ "$f" -nt "$EXE" ] && stale=$f
    done
    if [ -n "$stale" ]; then
      echo "pre-commit: $stale is newer than v1.exe - palette_v2.vox NOT regenerated (not fatal)" >&2
      echo "            build and commit again, or accept the stale plate." >&2
    elif (cd engine && timeout 300 ./build/bin/Release/v1.exe --background --palette-vox) >/dev/null 2>&1; then
      # status --porcelain, NOT `git diff --quiet`. That asks "has this TRACKED file moved" and answers
      # "no" for a file git has never seen, so the very first commit of a plate would silently not carry
      # it. --porcelain covers untracked, modified and already-staged alike.
      if [ -n "$(git status --porcelain -- game/assets/palette_v2.vox)" ]; then
        git add game/assets/palette_v2.vox && echo "pre-commit: regenerated and staged game/assets/palette_v2.vox"
      fi
    else
      echo "pre-commit: --palette-vox failed - game/assets/palette_v2.vox may be stale (not fatal)" >&2
    fi
  fi
fi

exit 0
