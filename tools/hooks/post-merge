#!/bin/sh
# voxelbit post-merge -- the engine's artifact is an exe, and git cannot see it.
#
# WHAT THIS FILE USED TO BE (2026-09-21). Most of it guarded game/index.html:
# git does not run pre-commit for an automatic merge commit, so that commit was
# the only one in the repo that skipped the browser bundle's rebuild and its
# eleven checks -- and it was exactly the commit where parallel work combined.
# The browser engine has been retired, and the block that rebuilt and linted it
# went with it.
#
# WHAT IS LEFT IS THE PART THAT ALWAYS MATTERED MORE. The engine's artifact is
# an exe that is NOT in the repository, so a merge changes the source underneath
# it and git reports a perfectly clean tree. The engine still launches, and runs
# a mixture of the C++ you had and the shaders you just pulled -- which is worse
# than a build failure, because nothing anywhere says so.
#
# Separate script rather than more of this file, because it is also worth
# running by hand -- after a rebase, after a stash pop, or for an engine you
# just closed. See tools/rebuild-engines.sh.
cd "$(git rev-parse --show-toplevel)" || exit 0

[ "$1" = "1" ] && exit 0           # squash merge: nothing committed yet, pre-commit still runs

sh tools/rebuild-engines.sh

exit 0
