#!/bin/sh
# voxelbit pre-push -- backstop only.
#
# WHAT THIS USED TO GUARD (2026-09-21). By push time the commits exist, so this
# can repair nothing; its one job was refusing to send a game/index.html that
# did not match the src/ it was bundled from, which happened whenever somebody
# committed with --no-verify or a rebase replayed the fragments without
# rebuilding. The browser engine has been retired and there is no bundle left
# to disagree with itself.
#
# WHAT IS LEFT IS THE HOOKS THEMSELVES. tools/hooks/ only reaches another
# worktree if it is in a COMMIT -- staged is not enough, and the post-merge hook
# is what installs it there -- so a push that carries a hook change in the index
# but not in history silently leaves every other clone on the old hooks. That is
# the one question pre-commit cannot ask, and it is cheap to ask here.
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! git diff --cached --quiet -- tools/hooks 2>/dev/null; then
  echo "pre-push: tools/hooks has STAGED changes that are not committed." >&2
  echo "          A hook only reaches another clone from a commit. Commit it and push again." >&2
  exit 1
fi
exit 0
