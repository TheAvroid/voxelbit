# Build trees. Both are generated by build.bat / build_rtxgi.bat and neither
# belongs in history: build-rtxgi/ in particular carries .obj, .lib and CMake
# caches with absolute paths baked into them, so a checkout on another machine
# would be worse off with them than without.
build/
build-rtxgi/

# Screenshots. P in the viewer writes v6_shot_NNN.png next to the launcher, and
# --out lands wherever it was pointed; none of that is source.
*.png

# Streamline's log, written under build/ but also wherever V6_SL_LOG points.
sl-log/
*.log
