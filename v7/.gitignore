build/

# The Falcor 8.0 fork and its packman dependencies -- 678 MB, and 18 of the
# directories under it are NTFS junctions into C:\packman-repo rather than real
# trees, which git cannot represent usefully.
#
# WARNING: the fork is HAND-PATCHED and those patches are not captured here.
# See v7/PATCHES.md for what was changed and why; without them v7 will not
# build. external/falcor is not a git repo of its own, so there is no diff to
# take against upstream.
external/
